# Public browser configuration only. Never put a service-role / secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Absolute production origin used for canonical URLs, sitemap and social previews.
SITE_URL=
# Optional, used only by `npm run refresh:parks`, never bundled into the browser.
NPS_API_KEY=
