{
  "name": "usa-travel-planner",
  "private": true,
  "version": "3.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:content && npm run prepare:images && node scripts/photo-credits.mjs && tsc --noEmit && vite build && node scripts/build-pages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "studio": "vite --mode studio --host 127.0.0.1 --port 5174 --strictPort",
    "check:content": "node scripts/check-content.mjs",
    "refresh:parks": "node scripts/refresh-parks.mjs",
    "test:cloud": "node scripts/test-cloud.mjs",
    "test:production": "playwright test --config playwright.production.config.ts",
    "prepare:images": "node scripts/prepare-images.mjs",
    "predev": "npm run prepare:images"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "prettier": "^3.9.6",
    "sharp": "0.35.4",
    "supabase": "2.117.0",
    "typescript": "~5.7.2",
    "vite": "^6.4.3"
  }
}
